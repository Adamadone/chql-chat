# Build stage
FROM node:20-alpine AS builder

WORKDIR /app

# Copy root package files (needed for workspace resolution)
COPY package*.json ./
COPY apps/mcp-server/package*.json ./apps/mcp-server/

# Install only the MCP server workspace dependencies
RUN npm ci --workspace=apps/mcp-server

# Copy source files needed for build
COPY tsconfig.base.json ./
COPY apps/mcp-server ./apps/mcp-server

# Build the MCP server
WORKDIR /app/apps/mcp-server
RUN npm run build

# Production stage
FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production

# Create non-root user
RUN addgroup --system --gid 1001 mcpserver && \
    adduser --system --uid 1001 mcpserver

# Copy root package files for workspace resolution
COPY package*.json ./
COPY apps/mcp-server/package*.json ./apps/mcp-server/

# Install production dependencies only
RUN npm ci --workspace=apps/mcp-server --omit=dev

# Copy compiled output from builder
COPY --from=builder --chown=mcpserver:mcpserver /app/apps/mcp-server/build ./apps/mcp-server/build

USER mcpserver

EXPOSE 3001

ENV MCP_PORT=3001

CMD ["node", "apps/mcp-server/build/index.js"]
