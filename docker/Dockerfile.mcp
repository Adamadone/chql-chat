FROM node:20-alpine AS builder

WORKDIR /app

# chql-core is a devDependency of mcp-server (its types are imported via
# `import type`, which TS erases at compile time — no runtime import).
# To build, we still need chql-core's dist/ for tsc to resolve the types.
#
# Order matters: copy chql-core SOURCES before npm ci, so chql-core's
# `prepare: tsc` hook has files to compile when npm runs it.
COPY package*.json ./
COPY apps/mcp-server/package*.json ./apps/mcp-server/
COPY packages/chql-core/package*.json ./packages/chql-core/
COPY tsconfig.base.json ./
COPY packages/chql-core ./packages/chql-core

# npm ci installs deps for both workspaces and, via the workspace symlink,
# runs chql-core's prepare hook (tsc) which produces packages/chql-core/dist.
RUN npm ci --workspace=apps/mcp-server --workspace=packages/chql-core

COPY apps/mcp-server ./apps/mcp-server
WORKDIR /app/apps/mcp-server
RUN npm run build

FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production

RUN addgroup --system --gid 1001 mcpserver && \
    adduser --system --uid 1001 mcpserver

# Runtime stage: chql-core is NOT installed. The compiled MCP server JS
# (apps/mcp-server/build/) contains no `require("@chql-chat/chql-core")`
# because every import from it was `import type`. --omit=dev cleanly skips
# chql-core (now a devDep) so we avoid running its prepare hook here.
COPY package*.json ./
COPY apps/mcp-server/package*.json ./apps/mcp-server/
RUN npm ci --workspace=apps/mcp-server --omit=dev

COPY --from=builder --chown=mcpserver:mcpserver /app/apps/mcp-server/build ./apps/mcp-server/build

USER mcpserver

EXPOSE 3001

ENV MCP_PORT=3001

CMD ["node", "apps/mcp-server/build/index.js"]
