FROM node:20-alpine AS builder

WORKDIR /app

# Install deps for the mcp-server workspace AND its sibling chql-core workspace
# (which provides shared SearchEnvelope types). Skip lifecycle scripts so
# chql-core's `prepare: tsc` doesn't run before its sources are in place.
COPY package*.json ./
COPY apps/mcp-server/package*.json ./apps/mcp-server/
COPY packages/chql-core/package*.json ./packages/chql-core/
RUN npm ci --workspace=apps/mcp-server --workspace=packages/chql-core --ignore-scripts

# Build chql-core first so its dist/ exists when the MCP server's tsc resolves
# the @chql-chat/chql-core import.
COPY tsconfig.base.json ./
COPY packages/chql-core ./packages/chql-core
RUN npm run build -w packages/chql-core

COPY apps/mcp-server ./apps/mcp-server
WORKDIR /app/apps/mcp-server
RUN npm run build

FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production

RUN addgroup --system --gid 1001 mcpserver && \
    adduser --system --uid 1001 mcpserver

# Same workspace setup as builder, minus dev deps. The chql-core package.json
# is required for npm to create the workspace symlink under node_modules.
COPY package*.json ./
COPY apps/mcp-server/package*.json ./apps/mcp-server/
COPY packages/chql-core/package*.json ./packages/chql-core/
RUN npm ci --workspace=apps/mcp-server --workspace=packages/chql-core --omit=dev --ignore-scripts

# Compiled artifacts: chql-core's dist is what the MCP server imports at runtime
# via the workspace symlink (packages/chql-core/dist/index.js).
COPY --from=builder --chown=mcpserver:mcpserver /app/packages/chql-core/dist ./packages/chql-core/dist
COPY --from=builder --chown=mcpserver:mcpserver /app/apps/mcp-server/build ./apps/mcp-server/build

USER mcpserver

EXPOSE 3001

ENV MCP_PORT=3001

CMD ["node", "apps/mcp-server/build/index.js"]
