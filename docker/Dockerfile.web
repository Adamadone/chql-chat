FROM node:20-alpine AS builder

WORKDIR /app

ARG NEXT_PUBLIC_CONVEX_URL

# Web depends on convex/ (aliased in tsconfig), and convex/ai.ts imports
# @chql-chat/chql-core. The Next.js type-check phase needs chql-core
# resolvable, so install + build it alongside the web workspace.
COPY package*.json ./
COPY apps/web/package*.json ./apps/web/
COPY packages/chql-core/package*.json ./packages/chql-core/
RUN npm ci --workspace=apps/web --workspace=packages/chql-core --ignore-scripts

COPY tsconfig.base.json ./
COPY packages/chql-core ./packages/chql-core
RUN npm run build -w packages/chql-core

COPY convex ./convex
COPY apps/web ./apps/web

ENV NEXT_PUBLIC_CONVEX_URL=${NEXT_PUBLIC_CONVEX_URL}
WORKDIR /app/apps/web
RUN npm run build

FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder /app/apps/web/public ./apps/web/public

USER nextjs

EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

CMD ["node", "apps/web/server.js"]
