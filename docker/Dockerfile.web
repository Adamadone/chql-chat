# Build stage
FROM node:20-alpine AS builder

WORKDIR /app

# Build arg: the only value needed at build time (baked into client JS bundle)
ARG NEXT_PUBLIC_CONVEX_URL

# Copy package files
COPY package*.json ./
COPY apps/web/package*.json ./apps/web/
COPY packages/shared/package*.json ./packages/shared/

# Install dependencies
RUN npm ci --workspace=@chql/shared --workspace=apps/web

# Copy source code
COPY tsconfig.base.json ./
COPY packages/shared ./packages/shared
COPY convex ./convex
COPY apps/web ./apps/web

# Build shared package
RUN npm run build --workspace=@chql/shared

# Build Next.js app (NEXT_PUBLIC_* vars must be present at build time)
ENV NEXT_PUBLIC_CONVEX_URL=${NEXT_PUBLIC_CONVEX_URL}
WORKDIR /app/apps/web
RUN npm run build

# Production stage
FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production

# Create non-root user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# Copy built assets
# Copy the entire standalone output (preserves monorepo structure)
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/standalone ./
# Copy static files into the correct nested path
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/static ./apps/web/.next/static
# Copy public files into the correct nested path
COPY --from=builder /app/apps/web/public ./apps/web/public


USER nextjs

EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

CMD ["node", "apps/web/server.js"]
