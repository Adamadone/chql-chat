# =============================================================================
# Caddyfile — Reverse proxy for chql-chat production deployment
# =============================================================================
# Replace the domain names below with your actual domains.
# Caddy automatically provisions HTTPS certificates via Let's Encrypt.
#
# DNS setup required:
#   chql.example.com    → A record → <your-hetzner-server-ip>
#   mcp.example.com     → A record → <your-hetzner-server-ip>
# =============================================================================

# Next.js frontend
chql.example.com {
	reverse_proxy web:3000
}

# MCP server (Convex actions connect here over HTTPS)
mcp.example.com {
	reverse_proxy mcp-server:3001
}
