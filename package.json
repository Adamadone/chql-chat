{
  "name": "chql-chat",
  "version": "0.1.0",
  "private": true,
  "description": "Natural language to DSL query converter with Convex backend and MCP architecture",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "dotenvx run -- concurrently --names web,convex --prefix-colors cyan,yellow \"npm run dev -w apps/web\" \"npm run convex:dev\"",
    "dev:web": "dotenvx run -- npm run dev -w apps/web",
    "build": "dotenvx run -- npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:build": "docker-compose build",
    "docker:logs": "docker-compose logs -f",
    "convex:dev": "dotenvx run -- npx convex dev",
    "convex:deploy": "dotenvx run -- npx convex deploy",
    "mcp:build": "npm run build -w apps/mcp-server",
    "mcp:dev": "npm run dev -w apps/mcp-server",
    "mcp:dev:run": "npm run build -w apps/mcp-server && node apps/mcp-server/build/index.js",
    "mcp:start": "dotenvx run -- npm run start -w apps/mcp-server"
  },
  "keywords": [
    "dsl",
    "mcp",
    "llm",
    "chat",
    "convex",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.52.0",
    "concurrently": "^9.1.0",
    "convex": "^1.32.0",
    "jose": "^6.1.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@auth/core": "^0.41.1",
    "@convex-dev/auth": "^0.0.90",
    "@convex-dev/migrations": "^0.3.1",
    "@modelcontextprotocol/sdk": "^1.26.0"
  }
}
